generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Barbershop {
  id                   Int       @id @default(autoincrement())
  email                String    @unique
  name                 String
  password             String
  customerId           String?
  image                String?
  address              String
  phone                String
  status               Boolean   @default(true)
  resetPasswordToken   String?   @unique
  resetPasswordExpires DateTime?
  slug                 String    @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees         Employee[]
  services          Service[]
  subscription      Subscription?
  employeeSchedules EmployeeSchedule[]
  appointments      Appointment[]
  appointmentBlocks AppointmentBlocking[]
  customers         Customer[]

  @@index([email])
  @@index([resetPasswordToken])
  @@index([slug])
}

model Subscription {
  id      String  @id @default(uuid())
  status  String
  plan    Plan
  priceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  barbershopId Int        @unique
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])
}

enum Plan {
  FREE
  PROFISSIONAL
}

model EmployeeSchedule {
  id        String  @id @default(uuid())
  name      String
  isDefault Boolean @default(false)

  barbershopId Int
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])

  employee                 Employee[]
  employeeScheduleWeekdays EmployeeScheduleWeekday[]
}

model EmployeeScheduleWeekday {
  id                 String           @id @default(uuid())
  employeeScheduleId String
  employeeSchedule   EmployeeSchedule @relation(fields: [employeeScheduleId], references: [id], onDelete: Cascade)
  weekday            Int
  isWorkingDay       Boolean          @default(true)
  start              String?
  startLunch         String?
  endLunch           String?
  end                String?

  @@unique([weekday, employeeScheduleId])
}

model Employee {
  id    Int     @id @default(autoincrement())
  name  String
  image String?

  barbershopId       Int
  barbershop         Barbershop       @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  employeeScheduleId String
  employeeSchedule   EmployeeSchedule @relation(fields: [employeeScheduleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services          Service[]
  appointments      Appointment[]
  appointmentBlocks AppointmentBlocking[]
}

model Customer {
  id           Int           @id @default(autoincrement())
  name         String
  phone        String
  email        String?       @unique
  qtdVisit     Int           @default(1)
  isBlocked    Boolean       @default(false)
  appointments Appointment[]
  barbershopId Int
  barbershop   Barbershop    @relation(fields: [barbershopId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([phone, barbershopId])
}

model Service {
  id                   String  @id @default(uuid())
  name                 String
  price                Int
  duration             Int
  status               Boolean @default(true)
  assignToAllEmployees Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  barbershopId Int
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])

  employees    Employee[]
  appointments Appointment[]
}

model Appointment {
  id                   String   @id @default(uuid())
  date                 DateTime
  time                 String
  totalServiceDuration Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeId   Int
  employee     Employee   @relation(fields: [employeeId], references: [id])
  barbershopId Int
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])
  customerId   Int
  customer     Customer   @relation(fields: [customerId], references: [id])

  services Service[]

  @@index([date])
}

model AppointmentBlocking {
  id           String     @id @default(uuid())
  initialDate  DateTime
  finalDate    DateTime
  initialTime  String
  finalTime    String
  barbershopId Int
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])
  employeeId   Int
  employee     Employee   @relation(fields: [employeeId], references: [id])

  @@index([initialDate])
}
