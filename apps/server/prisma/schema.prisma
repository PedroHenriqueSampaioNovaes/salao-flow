generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Barbershop {
  id                   Int       @id @default(autoincrement())
  email                String    @unique
  name                 String
  businessName         String
  password             String
  timezone             String
  customerId           String?
  image                String?
  address              String
  phone                String
  status               Boolean   @default(true)
  resetPasswordToken   String?   @unique
  resetPasswordExpires DateTime?
  slug                 String    @unique
  whatsAppUrl          String?
  facebookUrl          String?
  instagramUrl         String?
  isRecruiter          Boolean   @default(false)
  expiresAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees         Employee[]
  services          Service[]
  subscription      Subscription?
  employeeSchedules EmployeeSchedule[]
  appointments      Appointment[]
  scheduleBlocks    ScheduleBlock[]
  customers         Customer[]

  @@index([email])
  @@index([resetPasswordToken])
  @@index([slug])
  @@index([isRecruiter, expiresAt])
}

model Subscription {
  id             String   @id @default(uuid())
  status         String
  plan           Plan
  priceId        String
  subscriptionId String   @unique
  trialEndsAt    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  barbershopId Int        @unique
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])
}

enum Plan {
  PROFISSIONAL
}

model EmployeeSchedule {
  id        String  @id @default(uuid())
  name      String
  isDefault Boolean @default(false)

  barbershopId Int
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])

  employee                 Employee[]
  employeeScheduleWeekdays EmployeeScheduleWeekday[]
}

model EmployeeScheduleWeekday {
  id                 String           @id @default(uuid())
  employeeScheduleId String
  employeeSchedule   EmployeeSchedule @relation(fields: [employeeScheduleId], references: [id], onDelete: Cascade)
  weekday            Int
  isWorkingDay       Boolean          @default(true)
  start              String?
  startLunch         String?
  endLunch           String?
  end                String?

  @@unique([weekday, employeeScheduleId])
}

model Employee {
  id    Int    @id @default(autoincrement())
  name  String
  image String

  barbershopId       Int
  barbershop         Barbershop       @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  employeeScheduleId String
  employeeSchedule   EmployeeSchedule @relation(fields: [employeeScheduleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services       Service[]
  appointments   Appointment[]
  scheduleBlocks ScheduleBlock[]
}

model Customer {
  id           Int           @id @default(autoincrement())
  name         String
  phone        String
  email        String?
  visitCount   Int           @default(1)
  isBlocked    Boolean       @default(false)
  appointments Appointment[]
  barbershopId Int
  barbershop   Barbershop    @relation(fields: [barbershopId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([phone, barbershopId])
}

model Service {
  id                   String  @id @default(uuid())
  name                 String
  description          String?
  price                Int
  duration             Int
  status               Boolean @default(true)
  assignToAllEmployees Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  barbershopId Int
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])

  employees           Employee[]
  appointmentServices AppointmentService[]
}

model Appointment {
  id                   String   @id @default(uuid())
  date                 DateTime
  totalServiceDuration Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeId   Int
  employee     Employee   @relation(fields: [employeeId], references: [id])
  barbershopId Int
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])
  customerId   Int
  customer     Customer   @relation(fields: [customerId], references: [id])

  appointmentServices AppointmentService[]

  @@index([date])
}

model AppointmentService {
  id       String @id @default(uuid())
  name     String
  price    Int
  duration Int

  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId     String?
  service       Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model ScheduleBlock {
  id           String     @id @default(uuid())
  name         String
  initialDate  DateTime
  finalDate    DateTime
  barbershopId Int
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])
  employees    Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([initialDate, finalDate])
}
